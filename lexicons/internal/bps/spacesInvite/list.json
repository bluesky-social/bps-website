{
  "lexicon": 1,
  "id": "internal.bps.spacesInvite.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "List atproto spaces alpha invites belonging to the caller.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["codes"],
          "properties": {
            "codes": {
              "type": "array",
              "items": { "type": "ref", "ref": "#invite" }
            }
          }
        }
      }
    },
    "invite": {
      "type": "object",
      "required": ["code", "available", "uses", "disabled", "createdAt"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "available": { "type": "integer", "minimum": 0 },
        "uses": { "type": "integer", "minimum": 0 },
        "disabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
