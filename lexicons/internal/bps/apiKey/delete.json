{
  "lexicon": 1,
  "id": "internal.bps.apiKey.delete",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete (revoke) one of the caller's API keys.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
