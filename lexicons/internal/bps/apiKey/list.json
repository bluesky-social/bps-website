{
  "lexicon": 1,
  "id": "internal.bps.apiKey.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the caller's Jetstream API keys (metadata only; never the secret).",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["keys"],
          "properties": {
            "keys": {
              "type": "array",
              "items": { "type": "ref", "ref": "#keyMeta" }
            }
          }
        }
      }
    },
    "keyMeta": {
      "type": "object",
      "required": ["id", "label", "preview", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "preview": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "expiresAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
