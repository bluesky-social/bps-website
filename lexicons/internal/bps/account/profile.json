{
  "lexicon": 1,
  "id": "internal.bps.account.profile",
  "defs": {
    "main": {
      "type": "query",
      "description": "The caller's bsky profile (handle, display name, avatar), fetched live.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "handle"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did"
            },
            "handle": {
              "type": "string",
              "maxLength": 253
            },
            "displayName": {
              "type": "string",
              "maxLength": 640
            },
            "avatar": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      }
    }
  }
}
