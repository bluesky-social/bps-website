# App config (BPS_-prefixed)
BPS_PORT=8080
BPS_DATABASE_URL=postgres://bps:bps@localhost:5433/bps_account
BPS_SITE_ORIGIN=http://localhost:3000
BPS_API_ORIGIN=http://127.0.0.1:8080
BPS_COOKIE_DOMAIN=localhost
BPS_IRON_SESSION_PASSWORD=dev-only-password-change-me-min-32-chars

# OAuth (Phase 2)
BPS_OAUTH_HANDLE_RESOLVER=https://bsky.social
BPS_OAUTH_KEY_ID=bps1
# PKCS8 PEM or JWK JSON. Leave UNSET in local dev to use an ephemeral generated key.
# REQUIRED in production.
BPS_OAUTH_PRIVATE_KEY=

# AppView for public profile reads (handle/displayName/avatar). Unauthenticated.
BPS_APPVIEW_URL=https://public.api.bsky.app

# Gatekeeper (optional). When BPS_GATEKEEPER_URL is set, API keys are stored in
# Gatekeeper instead of local Postgres, and the other BPS_GATEKEEPER_* vars
# become required. Leave all three unset to keep the local Postgres provider.
BPS_GATEKEEPER_URL=
BPS_GATEKEEPER_BEARER_TOKEN=
BPS_GATEKEEPER_EMAIL=

# ATProto Spaces alpha invite authority (optional in local development).
# Both values are required when either is set. This may be a standalone PDS or
# an Entryway that implements the PDS admin invite Lexicons.
BPS_SPACES_PDS_URL=
BPS_SPACES_PDS_ADMIN_PASSWORD=

# Policy attached to newly created Jetstream API keys, as a JSON string. Unset
# uses the built-in default (100 TiB / 30 days, 64 GiB burst — see
# src/apikeys/jetstream-policy.ts). When set it REPLACES that default outright;
# nothing is merged. Only parsed here — Gatekeeper validates the schema, so a
# well-formed but wrong document fails at key creation, not at boot.
# BPS_JETSTREAM_KEY_POLICY={"version":1,"limits":{"egress_bytes":{"default":{"bytes":109951162777600,"period_seconds":2592000,"burst_bytes":68719476736}}}}
BPS_JETSTREAM_KEY_POLICY=

# Ecosystem-standard (NOT BPS_-prefixed)
NODE_ENV=development
OTEL_SERVICE_NAME=bps-account-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true
